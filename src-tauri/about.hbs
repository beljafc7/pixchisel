<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PixChisel third-party licenses</title>
    <style>
      :root { color-scheme: light dark; }
      body { font: 15px/1.5 system-ui, sans-serif; margin: 0; }
      main { margin: 0 auto; max-width: 960px; padding: 32px; }
      pre { border: 1px solid #8886; border-radius: 8px; max-height: 320px;
        overflow: auto; padding: 16px; white-space: pre-wrap; }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <main>
      <h1>PixChisel third-party licenses</h1>
      <p>
        This document contains the license texts collected from the locked Rust
        dependencies used to build PixChisel for macOS and Windows.
      </p>
      <h2>License overview</h2>
      <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
        {{/each}}
      </ul>
      <h2>License texts</h2>
      {{#each licenses}}
      <section>
        {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
        <h4>{{name}}</h4>
        <p>Used by:</p>
        <ul>
          {{#each used_by}}
          <li>
            <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">
              {{crate.name}} {{crate.version}}
            </a>
          </li>
          {{/each}}
        </ul>
        <pre>{{text}}</pre>
      </section>
      {{/each}}
    </main>
  </body>
</html>
